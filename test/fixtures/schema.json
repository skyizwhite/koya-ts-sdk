{
  "koyaSchema": 1,
  "webhooks": [{ "label": "revalidate", "url": "https://example.com/api/revalidate" }],
  "models": [
    {
      "name": "blog",
      "kind": "list",
      "label": "title",
      "fields": [
        { "name": "title", "type": "text", "required": true, "help": "Shown in lists and the page title" },
        { "name": "slug", "type": "slug" },
        { "name": "cover", "type": "media" },
        { "name": "content", "type": "richtext" },
        { "name": "category", "type": "select", "options": ["tech", "life"] },
        { "name": "author", "type": "reference", "model": "author" },
        { "name": "tags", "type": "reference", "model": "tag", "many": true },
        { "name": "gallery", "type": "media", "many": true },
        { "name": "meta", "type": "custom", "customField": "seo" },
        { "name": "blocks", "type": "repeater", "customFields": ["heading", "quote"], "required": true }
      ]
    },
    {
      "name": "author",
      "kind": "list",
      "fields": [
        { "name": "name", "type": "text", "required": true },
        { "name": "avatar", "type": "media" },
        { "name": "mentor", "type": "reference", "model": "author" }
      ]
    },
    { "name": "tag", "kind": "list", "fields": [{ "name": "name", "type": "text", "required": true }] },
    {
      "name": "site-settings",
      "kind": "object",
      "fields": [
        { "name": "maintenance", "type": "boolean", "required": true, "default": false },
        { "name": "postsPerPage", "type": "number", "integer": true, "min": 1 }
      ]
    }
  ],
  "customFields": [
    {
      "name": "seo",
      "fields": [
        { "name": "title", "type": "text", "maxLength": 60 },
        { "name": "image", "type": "media", "help": "1200x630" },
        { "name": "author", "type": "reference", "model": "author" }
      ]
    },
    { "name": "heading", "fields": [{ "name": "text", "type": "text", "required": true }] },
    {
      "name": "quote",
      "fields": [
        { "name": "text", "type": "textarea", "required": true },
        { "name": "by", "type": "reference", "model": "author", "many": true }
      ]
    },
    { "name": "footer", "fields": [{ "name": "note", "type": "text" }] }
  ]
}
